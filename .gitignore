# Worktree storage used by the Agent tool when running with isolation: "worktree".
# Branches created in worktrees still live in this repo's .git/refs and are pushable
# directly; the worktree directories themselves are ephemeral and never tracked.
.claude/worktrees/

# Local-only Claude Code settings (also covered by global ignore).
.claude/settings.local.json

# Vendored read-only reference checkouts (e.g. open-saas) — re-cloned on demand,
# not committed. The environment may clone the full upstream repo here on top of
# the curated subset that is tracked; ignore the rest so it never lands in a PR.
.claude/references/*/

# Python build/runtime artifacts.
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local SQLite dev/test database (default DATABASE_URL target; never committed).
*.db

# Node.
node_modules/

# Local environment files — never commit (T01-08 standard). The committed
# template is .env.example.
.env
.env.*
!.env.example

# Terraform local state and caches (T01-09).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
