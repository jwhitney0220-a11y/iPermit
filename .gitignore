# Worktree storage used by the Agent tool when running with isolation: "worktree".
# Branches created in worktrees still live in this repo's .git/refs and are pushable
# directly; the worktree directories themselves are ephemeral and never tracked.
.claude/worktrees/

# Local-only Claude Code settings (also covered by global ignore).
.claude/settings.local.json

# Python build/runtime artifacts.
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node.
node_modules/

# Local environment files — never commit (T01-08 standard). The committed
# template is .env.example.
.env
.env.*
!.env.example

# Terraform local state and caches (T01-09).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
