# iPermit — environment variable contract (T01-08)
#
# This file is the AUTHORITATIVE LIST of every environment variable the platform
# reads. It is committed; the real `.env` is NOT (see .gitignore). Copy this file
# to `.env` for local development and fill in real values.
#
#   cp .env.example .env
#
# RULES (see docs/operations/environments.md for the full standard):
#   - Placeholders only. NEVER commit a real secret, password, key, or token here.
#   - Add a variable here the moment code starts reading it, with a comment.
#   - Secrets in staging/production come from a secret manager, NOT from a
#     committed file. The *_SECRET_REF variables below name the lookup key, not
#     the value.
#   - Naming: UPPER_SNAKE_CASE, prefixed by component (IPERMIT_, DB_, GIS_,
#     STORAGE_, AUTH_, AI_).
#
# ---------------------------------------------------------------------------

# === Runtime / app ===
# One of: local | staging | production
IPERMIT_ENV=local
# Log level: debug | info | warning | error
IPERMIT_LOG_LEVEL=debug
# Bind address/port for FastAPI services (local dev defaults).
IPERMIT_API_HOST=127.0.0.1
IPERMIT_API_PORT=8000

# === Database (PostgreSQL 16 + PostGIS — ADR-0001) ===
# Local dev uses a plain connection string with an inline password placeholder.
# In staging/production this whole URL is provided by the secret manager
# (see DATABASE_URL_SECRET_REF) — do NOT inline credentials outside local.
DATABASE_URL=postgresql://ipermit:CHANGE_ME_LOCAL_ONLY@localhost:5432/ipermit
# Secret-manager lookup key that resolves to the full DATABASE_URL in
# staging/production. The value at this key is never stored in the repo.
DATABASE_URL_SECRET_REF=ipermit/<env>/database-url
# Connection pool sizing (per service process).
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
# Statement timeout in milliseconds (0 = disabled).
DB_STATEMENT_TIMEOUT_MS=30000

# === PostGIS / spatial (planning in T01-16; stand-up in T05-01) ===
# Whether spatial features are expected to be available in this environment.
# When true, the app asserts the PostGIS extension is installed at startup.
GIS_POSTGIS_ENABLED=false
# Minimum PostGIS version the app requires (asserted at startup when enabled).
GIS_POSTGIS_MIN_VERSION=3.4
# Default SRID for stored geometries (EPSG:4326 = WGS84 lon/lat).
GIS_DEFAULT_SRID=4326
# Max upload size (MB) for shapefile/KMZ route files (EPIC-05).
GIS_MAX_UPLOAD_MB=50

# === Object storage (uploaded shapefiles/KMZ, exported deliverables) ===
# Provider: local | s3 | gcs  (local uses a filesystem path for dev)
STORAGE_PROVIDER=local
# Local-only filesystem root for uploads when STORAGE_PROVIDER=local.
STORAGE_LOCAL_PATH=./.local-storage
# Bucket name in staging/production (S3/GCS).
STORAGE_BUCKET=ipermit-<env>-uploads
STORAGE_REGION=us-east-2
# Secret-manager lookup key for object-storage credentials (staging/prod).
# Local dev needs no credentials. NEVER inline access keys here.
STORAGE_CREDENTIALS_SECRET_REF=ipermit/<env>/storage-credentials

# === Auth / RBAC (contract owned by T01-14) ===
# Secret-manager lookup key for the JWT/session signing secret.
# Local dev may set AUTH_JWT_SECRET directly to a throwaway value.
AUTH_JWT_SECRET=CHANGE_ME_LOCAL_ONLY
AUTH_JWT_SECRET_REF=ipermit/<env>/auth-jwt-secret
# Access token lifetime in minutes.
AUTH_TOKEN_TTL_MINUTES=60
# Future SSO/OAuth issuer URL (left blank until T01-14 wires it).
AUTH_OIDC_ISSUER_URL=
# Per-client-IP rate limit on POST /api/v1/auth/login (S07-01). Process-local
# fixed-window counter; staging/prod swap in a shared-state limiter.
AUTH_LOGIN_RATE_PER_MINUTE=10

# === API hardening (S07-01) ===
# Comma-separated list of browser origins allowed by CORS. Wildcard "*" is
# allowed only when IPERMIT_ENV=local (credentialed CORS forbids it). Example:
# https://app.ipermit.example.com,https://www.ipermit.example.com
API_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated list of Host headers the API will accept. "*" (the default)
# is for local only; staging/prod must enumerate the public hostnames.
API_TRUSTED_HOSTS=*

# === AI assistance (constrained/advisory only — EPIC-09) ===
# Provider API key is resolved from the secret manager in all non-local envs.
# Leave blank locally unless actively developing extraction (T09-01).
AI_PROVIDER=anthropic
AI_API_KEY_SECRET_REF=ipermit/<env>/ai-api-key
# Feature flag: keep AI features off by default until EPIC-09.
AI_FEATURES_ENABLED=false

# === Email (S07-02, SAAS-07) ===
# Provider: local | smtp | ses  (local captures messages in memory for tests).
EMAIL_PROVIDER=local
# Sender address on outbound transactional mail (invitations etc.).
EMAIL_FROM_ADDRESS=noreply@ipermit.local
# How long a team invitation link is valid before expiring.
INVITATION_TTL_MINUTES=10080
# Frontend acceptance URL — the issued token is appended as ?token=...
INVITATION_ACCEPT_URL=http://localhost:5173/accept-invitation

# === Observability (placeholders; wired later) ===
# DSN/endpoint resolved from secret manager in non-local envs.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
