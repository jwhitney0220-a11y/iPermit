  "explanations": {
    "trigger_explanation": "A utility right of way on, across, under, or over state-owned land, including submerged land and some uplands, commonly triggers a Texas General Land Office miscellaneous easement."
  },
  "known_unknowns": [
    "Coastal public land projects may follow a coastal easement or lease path instead of a standard miscellaneous easement depending on site conditions and adjacent ownership."
  ],
